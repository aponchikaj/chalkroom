{
  "name": "@chalk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../schema/src --watch-path=../board/src --watch-path=../mock-tutor/src --import @swc-node/register/esm-register src/main.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "eval": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import @swc-node/register/esm-register eval/run.ts",
    "eval:retrieval": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import @swc-node/register/esm-register eval/retrieval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@chalk/board": "*",
    "@chalk/mock-tutor": "*",
    "@chalk/schema": "*",
    "@huggingface/transformers": "^4.3.1",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@supabase/supabase-js": "^2.118.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.13.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "nodemailer": "^10.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^8.0.2"
  }
}
