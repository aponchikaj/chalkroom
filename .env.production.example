# PRODUCTION (hosted Supabase). Copy to .env.production.local. Never commit .env.production.local.
# Used by `vite build` (production mode) and by `npm run db:push:prod`.
# Deployed API hosts (Railway/Fly/Render) get these as platform env vars instead.

SUPABASE_DB_PASSWORD=
# Session pooler (IPv4): Supabase dashboard > Connect > Session pooler. URL-encode the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- API ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
WEB_URL=https://<deployed-web-host>
SMTP_URL=smtps://<user>:<password>@<smtp-host>:465
MAIL_FROM=Chalkroom <no-reply@your-domain>
OTP_SECRET=
REQUIRE_ACCOUNT=1
# EMBEDDINGS=local     # the host needs ~150 MB disk for the model cache and ~300 MB RAM
EMBEDDING_CACHE=/tmp/chalkroom-models

# --- Web ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://<deployed-api-host>

# Supabase Storage over the S3 protocol (Dashboard > Storage > S3 connection). Not needed by the
# API, which uses Storage through the service-role key; for backups, bulk uploads and tools.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
