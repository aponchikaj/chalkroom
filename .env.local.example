# Copy to .env.local for personal overrides and secrets. Never commit .env.local.
# Loaded after .env by the API and by Vite, so every value here wins over .env.
# `npm run env` rewrites .env only, so this file survives it.

# --- Hosted Supabase project (leave unset to use local Supabase from .env) ---
SUPABASE_DB_PASSWORD=
# URL-encode special characters in the password (e.g. "@" becomes %40).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- API (NestJS) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# --- Web (Vite) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
