# LOCAL DEV personal secrets. Copy to .env.local. Never commit .env.local.
# Loaded after .env by the API and by Vite, so values here win over .env.
# Keep database settings out of this file: local dev uses the local Supabase in .env
# (`npm run env`); production settings live in .env.production.local.

# Set to use Claude; empty means the scripted mock tutor runs.
ANTHROPIC_API_KEY=
# MODEL=mock
