# Root .gitignore for the whole monorepo.
# Patterns without a leading "/" match at ANY depth, so they also cover future sub-projects
# (e.g. apps/web for Next.js, apps/api for NestJS, packages/*). Only one .gitignore is needed.

# =============================================================================
# Secrets and environment files (any directory)
# =============================================================================
.env
.env.*
*.env
.envrc
.direnv/
# Templates with placeholder values ARE committed so teammates know which vars exist.
# Never put real values in them.
!.env.example
!.env.*.example
!*.env.example
!.env.sample
!.env.template

# Keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
.secrets/
/secrets/
credentials.json
service-account*.json
*-credentials.json
*.secret
.npmrc.local
.netrc

# =============================================================================
# Node.js / package managers
# =============================================================================
node_modules/
jspm_packages/
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity
bower_components/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Caches
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.rollup.cache/
.swc/
.esbuild/
.vite/
*.tsbuildinfo
.node_repl_history
.temp/
.tmp/
tmp/

# =============================================================================
# Next.js
# =============================================================================
.next/
out/
next-env.d.ts
.vercel/
.netlify/

# =============================================================================
# NestJS / generic TypeScript builds
# =============================================================================
dist/
build/
lib-cov/
.nest/

# Other frameworks we might add
.nuxt/
.output/
.svelte-kit/
.astro/
.docusaurus/
.angular/
.expo/
.expo-shared/
storybook-static/
.remix/
.react-router/

# =============================================================================
# Monorepo tooling
# =============================================================================
.turbo/
.nx/cache/
.nx/workspace-data/

# =============================================================================
# Testing
# =============================================================================
coverage/
.nyc_output/
*.lcov
junit*.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# =============================================================================
# Databases and local data
# =============================================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
dump.rdb
prisma/*.db
prisma/*.db-journal
.data/
pgdata/
docker-volumes/

# =============================================================================
# Docker / infrastructure
# =============================================================================
docker-compose.override.yml
docker-compose.override.yaml
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.wrangler/
.serverless/
.firebase/
.amplify/
amplify/#current-cloud-backend/

# =============================================================================
# Python (AI / ML scripts, tooling)
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
/env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# =============================================================================
# AI tooling (keep shared config, ignore personal/local state)
# =============================================================================
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md
.cursor/*.local.*
.aider*

# =============================================================================
# Editors and IDEs
# =============================================================================
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.history/
.fleet/
.zed/

# =============================================================================
# Operating systems
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.fuse_hidden*
.nfs*

# =============================================================================
# Misc
# =============================================================================
*.bak
*.orig
*.rej
*.zip
*.tar.gz
*.tgz

# Impeccable design-review captures (regenerate with scripts/shoot.mjs)
.impeccable/scratch/
.impeccable/review/
.impeccable/ref/*.png
