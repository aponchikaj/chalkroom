# Copy to .env (or run `npm run env` with local Supabase running). Never commit .env.
# LOCAL DEV: local Supabase (Postgres 17 in Docker). Personal secrets go in .env.local;
# production (hosted Supabase) goes in .env.production.local. See the matching .example files.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# --- API (NestJS) ---
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
# Model: the first key set wins, in this order: Anthropic, Gemini, Groq; none: the scripted mock
# tutor runs. Put keys in .env.local. A failed model call falls back to the mock tutor.
# ANTHROPIC_API_KEY=sk-ant-...   # production: Claude Haiku 5.5 (claude-haiku-5-5)
# GEMINI_API_KEY=                # free tier for testing only (aistudio.google.com/apikey)
# GROQ_API_KEY=gsk_...           # older free tier for testing only
# MODEL=mock                     # force one: anthropic | gemini | groq | mock
# MODEL_ID=claude-haiku-5-5      # model for all four agents (default per provider)
# MODEL_ID_LEAD= / MODEL_ID_THREAD= / MODEL_ID_TRIAGE= / MODEL_ID_SCRIBE=   # one agent's model
# ANTHROPIC_EFFORT_LEAD=medium   # Claude effort per agent (LEAD / THREAD / TRIAGE / SCRIBE)
# GEMINI_RPM=10                  # requests per minute per Gemini model
# GEMINI_SPARES_TUTOR=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_SPARES_LITE=gemini-3.5-flash-lite,gemini-3.1-flash-lite   # spares for triage and the scribe
# GROQ_SPARES=openai/gpt-oss-20b,openai/gpt-oss-120b               # Groq models to fall back to
# PIPELINE=1                     # write the next segment during the gate (default: on, off on free tiers)
# ROOM_TOKEN_BUDGET=300000       # tokens a room may spend before the backup tutor takes over
# MOCK_DELAY_MS=400              # delay between scripted steps of the mock tutor
# API_PORT=3001                  # hosts set PORT instead
# WEB_URL=http://localhost:5173  # the web origin(s) allowed by CORS, comma separated
# SANDBOX=1                      # the /sandbox dev console (default: on against a local Supabase only)
# INSTANCE_GROUP=main            # instances take over each other's rooms only within a group
# INSTANCE_ID=                   # this instance's lease id (default: <group>/<host>:<port>)
# RESUME_ROOMS=0                 # do not resume live rooms at boot (extra instances, tests)
# Mailpit locally (npm run env writes it); production: your SMTP provider's URL
SMTP_URL=smtp://127.0.0.1:55425
# MAIL_FROM=Chalkroom <no-reply@chalkroom.local>
# OTP_SECRET=           # HMAC key for email 2FA codes, e.g. openssl rand -hex 32 (B11)
# REQUIRE_ACCOUNT=0     # accounts are required by default; 0 lets anonymous sessions in (B9)
# EMBEDDINGS=none       # RAG search: 'local' (default, multilingual-e5-small in the API) or 'none' (full text only)
# EMBEDDING_CACHE=      # where the embedding model is cached (default ~/.cache/chalkroom-models)

# --- Web (Vite) ---
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
