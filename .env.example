# Copy to .env (or run `npm run env` with local Supabase running). Never commit .env.
# LOCAL DEV: local Supabase (Postgres 17 in Docker). Personal secrets go in .env.local;
# production (hosted Supabase) goes in .env.production.local. See the matching .example files.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# --- API (NestJS) ---
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
# Set a key to use Claude; without one the scripted mock tutor runs.
ANTHROPIC_API_KEY=
# Groq (free tier) runs all four agents when set; put the key in .env.local
# GROQ_API_KEY=gsk_...
# MODEL=mock                 # force the mock tutor even with a key (groq | anthropic | mock)
# MODEL_ID=openai/gpt-oss-120b  # model for all four agents (Groq default; openai/gpt-oss-20b is faster)
# MOCK_DELAY_MS=400
# API_PORT=3001
# WEB_URL=http://localhost:5173
# Mailpit locally (npm run env writes it); production: your SMTP provider's URL
SMTP_URL=smtp://127.0.0.1:55425
# MAIL_FROM=Chalkroom <no-reply@chalkroom.local>
# OTP_SECRET=           # HMAC key for email 2FA codes, e.g. openssl rand -hex 32 (B11)
# REQUIRE_ACCOUNT=0     # accounts are required by default; 0 lets anonymous sessions in (B9)
# VOYAGE_API_KEY=       # embeddings for RAG; without it search is full-text only (B12)
# EMBEDDING_MODEL=voyage-3.5

# --- Web (Vite) ---
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
