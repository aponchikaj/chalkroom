# Copy to .env (or run `npm run env` with local Supabase running). Never commit .env.
# Personal overrides and secrets (hosted Supabase, API keys) go in .env.local; see .env.local.example.

# --- API (NestJS) ---
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
# Set a key to use Claude; without one the scripted mock tutor runs.
ANTHROPIC_API_KEY=
# MODEL=mock                 # force the mock tutor even with a key
# MODEL_ID=claude-haiku-4-5  # model for all four agents
# MOCK_DELAY_MS=400
# API_PORT=3001
# WEB_URL=http://localhost:5173

# --- Web (Vite) ---
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
